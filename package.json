{
	"name": "icon-palette",
	"version": "0.5.3",
	"description": "Set custom icons and colors on files, folders, tabs, tags, properties, and bookmarks, with a rulebook to apply them automatically.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"generate:icons": "node scripts/generate-icon-library-data.mjs",
		"build": "npm run generate:icons && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/check-bundle-size.mjs",
		"ci": "node scripts/ci-local.mjs",
		"scan-rules": "node scripts/check-scan-rules.mjs",
		"lint": "eslint . --max-warnings 0 && prettier --check \"**/*.ts\" && node scripts/check-submission.mjs && npm run typecheck:marketplace",
		"test": "vitest run",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"typecheck:marketplace": "tsc --noEmit -p tsconfig.scan.json",
		"knip": "knip",
		"type-coverage": "type-coverage",
		"test:mutation": "stryker run",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"version:check": "node scripts/check-version.mjs",
		"size:check": "node scripts/check-bundle-size.mjs",
		"release:notes": "node scripts/extract-release-notes.mjs",
		"prepare": "node .husky/install.mjs"
	},
	"typeCoverage": {
		"atLeast": 100,
		"ignoreFiles": ["**/__tests__/**", "**/__mocks__/**", "**/*.test.ts"]
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"icon",
		"icons",
		"color",
		"file-explorer"
	],
	"author": "Charles Kelsoe (ckelsoe)",
	"license": "MIT-0",
	"devDependencies": {
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "6.43.13",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@types/node": "^25.5.0",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"eslint-plugin-sonarjs": "^4.2.0",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"jsdom": "^31.0.0",
		"knip": "^6.32.1",
		"obsidian": "^1.14.4",
		"prettier": "^3.9.6",
		"tslib": "2.8.1",
		"type-coverage": "^2.30.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@iconify-json/devicon": "^1.2.62",
		"@iconify-json/simple-icons": "^1.2.87",
		"fflate": "^0.8.3"
	},
	"overrides": {
		"brace-expansion@^1.0.0": "1.1.21",
		"brace-expansion@^2.0.0": "2.1.7",
		"brace-expansion@^5.0.0": "5.0.12",
		"browserslist": "^4.28.7",
		"fast-uri": "^3.1.9",
		"glob": "^14.0.3",
		"handlebars": "^4.7.10",
		"js-yaml@^3.0.0": "3.15.2",
		"js-yaml@^4.0.0": "4.3.2",
		"moment": "^2.31.0",
		"qs": "^6.16.1",
		"smol-toml": "^1.9.0",
		"test-exclude": "^8.0.0",
		"zod": "^4.6.6",
		"minimatch@9": "^11.0.8",
		"minimatch@10": "^11.0.8",
		"type-coverage-core": {
			"minimatch": "^11.0.8"
		}
	}
}
