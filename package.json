{
	"name": "icon-palette",
	"version": "0.4.2",
	"description": "Set custom icons and colors on files, folders, tabs, tags, properties, and bookmarks, with a rulebook to apply them automatically.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"generate:icons": "node scripts/generate-icon-library-data.mjs",
		"build": "npm run generate:icons && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && node scripts/check-bundle-size.mjs",
		"lint": "eslint . --max-warnings 0 && prettier --check \"**/*.ts\" && node scripts/check-submission.mjs && npm run typecheck:marketplace",
		"test": "jest",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"typecheck:marketplace": "tsc --noEmit -p tsconfig.scan.json",
		"knip": "knip",
		"type-coverage": "type-coverage",
		"test:mutation": "stryker run",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"version:check": "node scripts/check-version.mjs",
		"size:check": "node scripts/check-bundle-size.mjs",
		"release:notes": "node scripts/extract-release-notes.mjs",
		"prepare": "husky"
	},
	"typeCoverage": {
		"atLeast": 99
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"icon",
		"icons",
		"color",
		"file-explorer"
	],
	"author": "Charles Kelsoe (ckelsoe)",
	"license": "MIT-0",
	"devDependencies": {
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.40.0",
		"@jest/globals": "^30.4.1",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/jest-runner": "^9.6.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.5.0",
		"esbuild": "^0.28.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"eslint-plugin-sonarjs": "^4.2.0",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"jest-environment-node": "^30.4.1",
		"jiti": "^2.7.0",
		"knip": "^6.32.1",
		"obsidian": "^1.13.1",
		"prettier": "^3.9.6",
		"ts-jest": "^29.4.11",
		"tslib": "2.8.1",
		"type-coverage": "^2.30.1",
		"typescript": "6.0.2",
		"typescript-eslint": "^8.62.1"
	},
	"dependencies": {
		"@iconify-json/devicon": "^1.2.62",
		"@iconify-json/simple-icons": "^1.2.87",
		"fflate": "^0.8.3"
	},
	"overrides": {
		"fast-uri": "^3.1.7",
		"qs": "^6.15.2",
		"js-yaml@^3.0.0": "3.15.1",
		"js-yaml@^4.0.0": "4.3.1",
		"brace-expansion@^1.0.0": "1.1.18",
		"brace-expansion@^2.0.0": "2.1.4",
		"brace-expansion@^5.0.0": "5.0.9"
	}
}
